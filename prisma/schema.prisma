generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Review {
  id             Int      @id @default(autoincrement())
  filmTitle      String
  personalRating Int
  reviewNotes    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
